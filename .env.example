# ────────────────────────────────────────────────────────────────────────────
# back bar — 環境変数テンプレート
#
# 3 環境構成:
#   local       → npm run dev（Mac / LAN 実機）
#   dev         → Vercel Dev プロジェクト（HTTPS・スマホ本番確認）
#   production  → Vercel 本番（公開用）
#
# このファイルをコピーして .env.local を作り、値を埋める:
#   cp .env.example .env.local
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# local / dev は Dev Supabase プロジェクト、production は別プロジェクトを使う
#
# Dashboard → Authentication → URL Configuration も設定すること:
#   Site URL: https://barten-diary.vercel.app
#   Redirect URLs（Additional）:
#     http://localhost:3000/**
#     http://192.168.x.x:3000/auth/callback        ← Local LAN 実機
#     https://barten-diary.vercel.app/auth/callback ← Prod
#     https://*-iago1102314-star.vercel.app/**      ← Vercel Preview（Dev）
#     https://*-iago1102314-stars-projects.vercel.app/**
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── OpenAI ───────────────────────────────────────────────────────────────────
# サーバー専用 — NEXT_PUBLIC_ にしない
OPENAI_API_KEY=sk-your-openai-api-key

# ── 環境識別 ──────────────────────────────────────────────────────────────────
# local | dev | production
# Vercel の Environment Variables で各環境ごとに設定する
NEXT_PUBLIC_APP_ENV=local

# ── Dev ショートカット ────────────────────────────────────────────────────────
# production 環境では APP_ENV=production のため自動的に無効。
# local / dev で表示したい場合は true にする。
NEXT_PUBLIC_ENABLE_DEV_SHORTCUT=false

# ── Local 実機テスト（local 環境のみ）────────────────────────────────────────
# npm run dev 起動時の "Network:" に表示される LAN IP。
# IP が変わったら更新する。
# Vercel 環境（dev / production）では設定不要。
#
# PWA 注意: ホーム画面追加は URL（オリジン）ごとに1つ。
# LAN IP が変わるたびに PWA の作り直しが必要になる。
# 実機 PWA テストは Vercel dev の固定 URL を使う方が楽（下記）。
LOCAL_LAN_IP=192.168.x.x

# ── Dev PWA 用 — 固定 URL ────────────────────────────────────────────────────
# Vercel の「デプロイごとに変わる Preview URL」で PWA を作らないこと。
#   NG: https://barten-diary-abc123xyz.vercel.app  （push のたびに変わる）
#   OK: https://<dev-project>.vercel.app            （Dev プロジェクトの Production URL）
#   OK: https://<dev-project>-git-dev-<user>.vercel.app  （dev ブランチ固定 URL）
#
# 設定手順（Vercel Dev プロジェクト）:
#   1. Settings → Git → Production Branch を `dev` にする
#   2. 上記 Production URL または git-dev URL を iPhone Safari で開く
#   3. 共有 → ホーム画面に追加（この URL だけ使い続ける）
# push 後も同じ URL のまま。PWA の作り直しは不要（中身はリロードで更新）。
#
# より安定させるなら: Settings → Domains で dev 用サブドomain を追加
#   例: dev.your-domain.com → dev ブランチ
